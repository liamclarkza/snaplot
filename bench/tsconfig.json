{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "snaplot": ["./src/api/shims/snaplot.d.ts"],
      "snaplot/react": ["./src/api/shims/snaplot-react.d.ts"]
    }
  },
  "include": ["src"]
}
