{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "root": false,
  "extends": "//",
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["src/examples/**", "!src/examples/data/**"],
      "formatter": { "lineWidth": 70 }
    }
  ]
}
