---
/**
 * The layout for pages outside the docs: the homepage and the examples hub (plan §9, §10.3).
 * No Starlight chrome, but the same header and footer components as the docs (SiteHeader,
 * SiteFooter). Nav, page and footer share one 72rem container with 24px gutters, anchored at the
 * same left edge as the docs header, so the brand never moves between layouts (uisite-12). The
 * theme script is the docs' own, so a choice made in either place holds in both.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/site.css';
import PrereleaseBanner from '../components/PrereleaseBanner.astro';
import ThemeProvider from '../components/ThemeProvider.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  /** Which nav item is the current page. */
  current?: 'home' | 'examples';
}

const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="snaplot" />
    <ThemeProvider />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <PrereleaseBanner rowClass="container" />
    <header class="site-header">
      <div class="site-header-bar"><SiteHeader current={current} /></div>
    </header>
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container"><SiteFooter /></div>
    </footer>
  </body>
</html>
