---
/**
 * <Example name="start/minimal" /> renders one example from src/examples/ in Vanilla, React and
 * Solid tabs (plan §8.3). Each tab shows the runnable file (Copy copies all of it) and mounts it
 * live when the tab is visible. The chosen framework is shared by every example and remembered;
 * storage is optional, so blocked storage never breaks the page (uisite-01).
 */
import { Code } from '@astrojs/starlight/components';
import { EXAMPLE_HEIGHT, FRAMEWORKS, exampleKind, tabFileName, tabSource } from '../lib/examples';
import ExampleReact from './ExampleReact.react.tsx';
import ExampleSolid from './ExampleSolid.solid.tsx';

interface Props {
  /** The example's path under src/examples/, without the suffix, e.g. "start/minimal". */
  name: string;
}

const { name } = Astro.props;

const sources = import.meta.glob<string>(
  ['../examples/**/*.ts', '../examples/**/*.tsx', '!../examples/data/**'],
  { query: '?raw', import: 'default', eager: true },
);
const files = new Map(
  Object.entries(sources).map(([path, source]) => [path.replace('../examples/', ''), source]),
);
const kind = exampleKind(name, new Set(files.keys()));
const input = {
  options: files.get(`${name}.options.ts`),
  files: {
    vanilla: files.get(`${name}.ts`),
    react: files.get(`${name}.react.tsx`),
    solid: files.get(`${name}.solid.tsx`),
  },
};

// Per-page state, shared by every <Example> on the page: a counter for unique ids (an example may
// appear twice) and whether the restore script has been emitted.
const COUNT = Symbol.for('snaplot:example-count');
const RESTORE = Symbol.for('snaplot:example-restore-script');
const page = Astro.locals as unknown as { [COUNT]?: number; [RESTORE]?: boolean };
page[COUNT] = (page[COUNT] ?? 0) + 1;
const id = `example-${page[COUNT]}`;
const firstOnPage = !page[RESTORE];
page[RESTORE] = true;

const tabs = FRAMEWORKS.map((framework) => ({
  ...framework,
  source: tabSource(kind, framework.id, input),
  fileName: tabFileName(name, kind, framework.id),
}));
---

{
  firstOnPage && (
    <script is:inline>
      (() => {
        // Shows the remembered framework tab before the example paints; storage may be blocked.
        let framework = null;
        try { framework = localStorage.getItem('snaplot-site-framework'); } catch {}
        if (!/^(vanilla|react|solid)$/.test(framework || '')) framework = null;
        customElements.define('snaplot-example-restore', class extends HTMLElement {
          connectedCallback() {
            const example = this.closest('snaplot-example');
            const tab = example && example.querySelector(':scope > [role="tablist"] > [data-framework="' + framework + '"]');
            if (!tab) return;
            example.setAttribute('data-framework', framework);
            for (const t of example.querySelectorAll(':scope > [role="tablist"] > [role="tab"]')) {
              t.setAttribute('aria-selected', String(t === tab));
              t.tabIndex = t === tab ? 0 : -1;
            }
            for (const p of example.querySelectorAll(':scope > [role="tabpanel"]')) {
              p.hidden = p.getAttribute('data-framework') !== framework;
            }
          }
        });
      })();
    </script>
  )
}

<snaplot-example class="example not-content" data-example={name} data-kind={kind} data-framework="vanilla">
  <div class="example-tabs" role="tablist" aria-label="Framework">
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${tab.id}`}
          aria-controls={`${id}-panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-framework={tab.id}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  {
    tabs.map((tab, i) => (
      <div
        class="example-panel"
        role="tabpanel"
        id={`${id}-panel-${tab.id}`}
        aria-labelledby={`${id}-tab-${tab.id}`}
        data-framework={tab.id}
        hidden={i !== 0}
      >
        <div class="example-output" data-example-output>
          {tab.id === 'vanilla' && (
            <snaplot-vanilla-mount class="example-chart" data-name={name} data-kind={kind} />
          )}
          {tab.id === 'react' && <ExampleReact client:visible name={name} kind={kind} />}
          {tab.id === 'solid' && <ExampleSolid client:visible name={name} kind={kind} />}
        </div>
        <div data-example-code data-file={tab.fileName}>
          <Code code={tab.source} lang={tab.lang} title={tab.fileName} />
        </div>
      </div>
    ))
  }
  <snaplot-example-restore />
</snaplot-example>

<style define:vars={{ chartHeight: `${EXAMPLE_HEIGHT}px` }}>
  /* One card: the framework switch, the chart on the raised surface, then its file. */
  .example {
    display: block;
    margin-block: 1.75rem;
    border: 1px solid var(--snaplot-rule);
    border-radius: var(--snaplot-radius-md);
    background-color: var(--snaplot-raised);
    box-shadow: var(--snaplot-shadow-sm);
    overflow: hidden;
  }
  /* The framework switch: a segmented control. */
  .example-tabs {
    display: inline-flex;
    gap: 2px;
    margin: 0.75rem 0.75rem 0;
    padding: 3px;
    border: 1px solid var(--snaplot-rule);
    border-radius: var(--snaplot-radius-pill);
    background-color: var(--snaplot-surface);
  }
  .example-tabs [role='tab'] {
    min-height: 2rem;
    padding: 0.25rem 0.875rem;
    border: 0;
    border-radius: var(--snaplot-radius-pill);
    background: none;
    color: var(--snaplot-ink-secondary);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    transition:
      color 120ms ease,
      background-color 120ms ease;
  }
  .example-tabs [role='tab']:hover {
    color: var(--snaplot-ink);
    background-color: color-mix(in srgb, var(--snaplot-ink) 6%, transparent);
  }
  .example-tabs [role='tab'][aria-selected='true'] {
    color: var(--snaplot-ink);
    font-weight: 600;
    background-color: var(--snaplot-raised);
    box-shadow: var(--snaplot-shadow-sm);
  }
  .example-output {
    padding: 1rem 1rem 0.75rem;
    min-height: var(--chartHeight);
  }
  .example-chart {
    display: block;
    height: var(--chartHeight);
  }
  /* The file runs the card's width under the chart, its frame folded into the card's. */
  [data-example-code] {
    border-top: 1px solid var(--snaplot-rule);
  }
  [data-example-code] :global(.expressive-code) {
    margin: 0;
  }
  [data-example-code] :global(.expressive-code .frame),
  [data-example-code] :global(.expressive-code .frame .header),
  [data-example-code] :global(.expressive-code .frame pre) {
    border-radius: 0;
  }
  [data-example-code] :global(.expressive-code .frame pre) {
    border-inline: 0;
    border-bottom: 0;
  }
  /* Controls an example adds of its own (month buttons, Back to live) take the site's pill style
     rather than the browser's; snaplot's own buttons keep theirs. */
  .example-output :global([role='group']) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .example-output :global(button:not([class*='snaplot'])) {
    min-height: 2rem;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--snaplot-ink);
    background: var(--snaplot-surface);
    border: 1px solid var(--snaplot-rule);
    border-radius: var(--snaplot-radius-pill);
    padding: 0.25rem 0.875rem;
    margin: 0 0 0.75rem;
    cursor: pointer;
  }
  .example-output :global([role='group'] > button:not([class*='snaplot'])) {
    margin: 0;
  }
  .example-output :global(button:not([class*='snaplot']):hover) {
    border-color: var(--snaplot-ink-secondary);
  }
  .example-output :global(label:not([class*='snaplot'])) {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    color: var(--snaplot-ink);
    margin-bottom: 0.5rem;
    cursor: pointer;
  }
  .example-output :global(input[type='checkbox']) {
    accent-color: var(--snaplot-accent);
    margin: 0;
  }
</style>

<script>
  import { defineVanillaMount } from '../lib/vanilla-mount';

  const STORAGE_KEY = 'snaplot-site-framework';
  const FRAMEWORKS = ['vanilla', 'react', 'solid'] as const;
  type Framework = (typeof FRAMEWORKS)[number];
  const isFramework = (value: unknown): value is Framework =>
    FRAMEWORKS.includes(value as Framework);

  function remember(framework: Framework): void {
    try {
      localStorage.setItem(STORAGE_KEY, framework);
    } catch {
      // Blocked storage: the choice lasts for this page only.
    }
  }

  class SnaplotExample extends HTMLElement {
    #tabs: HTMLButtonElement[] = [];
    #panels: HTMLElement[] = [];

    connectedCallback(): void {
      this.#tabs = [...this.querySelectorAll<HTMLButtonElement>(':scope > [role="tablist"] > [role="tab"]')];
      this.#panels = [...this.querySelectorAll<HTMLElement>(':scope > [role="tabpanel"]')];
      this.#tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => this.#choose(i));
        tab.addEventListener('keydown', (event) => {
          const last = this.#tabs.length - 1;
          const next =
            event.key === 'ArrowRight'
              ? (i + 1) % this.#tabs.length
              : event.key === 'ArrowLeft'
                ? (i + last) % this.#tabs.length
                : event.key === 'Home'
                  ? 0
                  : event.key === 'End'
                    ? last
                    : -1;
          if (next < 0) return;
          event.preventDefault();
          this.#choose(next);
          this.#tabs[next]?.focus();
        });
      });
      const restored = this.dataset.framework;
      this.show(isFramework(restored) ? restored : 'vanilla');
    }

    /** Shows one framework's panel without touching storage or other examples. */
    show(framework: Framework): void {
      this.dataset.framework = framework;
      this.#tabs.forEach((tab) => {
        const selected = tab.dataset.framework === framework;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      for (const panel of this.#panels) panel.hidden = panel.dataset.framework !== framework;
    }

    #choose(index: number): void {
      const framework = this.#tabs[index]?.dataset.framework;
      if (!isFramework(framework)) return;
      // Keep the example under the pointer still while the others change height.
      const top = this.getBoundingClientRect().top;
      for (const example of document.querySelectorAll<SnaplotExample>('snaplot-example')) {
        example.show(framework);
      }
      window.scrollBy({ top: this.getBoundingClientRect().top - top, behavior: 'instant' });
      remember(framework);
    }
  }

  customElements.define('snaplot-example', SnaplotExample);
  defineVanillaMount();
</script>
