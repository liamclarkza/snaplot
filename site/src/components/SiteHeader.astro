---
/**
 * The one site header (plan §9, uisite-12), used by the custom layout (Site.astro) and, through
 * the Header override, by every Starlight docs page: the name and documented version (docs-16),
 * the nav, the docs search where there is one, and the three-state theme toggle. The brand sits
 * at the same 24px gutter in both layouts. On a narrow screen the nav takes a second row; in the
 * docs the theme toggle then lives in Starlight's menu, beside the menu button.
 */
import { version } from '../lib/version';
import Mark from './Mark.astro';
import ThemeSelect from './ThemeSelect.astro';

export type Section = 'home' | 'docs' | 'examples' | 'api';

interface Props {
  /** The section the page belongs to, marked in the nav. */
  current?: Section;
  /** Starlight's layout: the menu button shares the first row on a narrow screen. */
  docs?: boolean;
}

const { current, docs = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const GITHUB = 'https://github.com/liamclarkza/snaplot';
const links: { label: string; href: string; section?: Section }[] = [
  { label: 'Docs', href: `${base}introduction/`, section: 'docs' },
  { label: 'Examples', href: `${base}examples/`, section: 'examples' },
  { label: 'API', href: `${base}reference/api/`, section: 'api' },
  { label: 'GitHub', href: GITHUB },
];
// A link to this very page is "page"; a link to the section this page is in is "true".
const here = Astro.url.pathname.replace(/\/?$/, '/');
const mark = (link: { href: string; section?: Section }) =>
  link.href === here ? 'page' : link.section && link.section === current ? 'true' : undefined;
---

<div class:list={['site-header-row', { 'is-docs': docs }]} data-site-header>
  <a
    class="brand"
    data-site-brand
    href={base}
    aria-current={current === 'home' ? 'page' : undefined}
  >
    <Mark size={28} />
    <span class="wordmark" translate="no">snaplot</span>
    <span class="site-version num" data-version={version}>v{version}</span>
  </a>
  <nav class="site-header-nav" aria-label="Site">
    <ul class="site-nav">
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={mark(link)}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="site-header-tools">
    <slot name="search" />
    <div class="site-header-theme"><ThemeSelect /></div>
  </div>
</div>

<style>
  .site-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.75rem;
    min-height: 100%;
    font-size: 0.9375rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--snaplot-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark {
    font-family: var(--snaplot-font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .brand:hover .wordmark {
    color: var(--snaplot-accent);
  }
  /* The point of the mark lifts a little on hover, as a new value would. */
  .brand :global(.mark-point) {
    transition: transform 200ms var(--snaplot-ease);
    transform-origin: 23px 9.5px;
  }
  .brand:hover :global(.mark-point) {
    transform: translate(1px, -1.5px) scale(1.12);
  }
  .site-version {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--snaplot-rule);
    border-radius: var(--snaplot-radius-pill);
    color: var(--snaplot-ink-secondary);
    font-family: var(--snaplot-font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--snaplot-radius-pill);
    color: var(--snaplot-ink-secondary);
    font-weight: 500;
    text-decoration: none;
    transition:
      color 120ms ease,
      background-color 120ms ease;
  }
  .site-nav a:hover {
    color: var(--snaplot-ink);
    background-color: var(--snaplot-surface);
  }
  .site-nav a[aria-current] {
    color: var(--snaplot-accent);
    background-color: var(--snaplot-accent-soft);
  }

  .site-header-tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-inline-start: auto;
  }

  /* Narrow screens: the brand and tools, then the nav on its own row. */
  @media (max-width: 49.99rem) {
    .site-header-row {
      column-gap: 1rem;
    }
    .site-header-nav {
      order: 3;
      flex-basis: 100%;
      /* The first pill's text lines up with the brand. */
      margin-inline-start: -0.75rem;
    }
    /* In the docs, Starlight's menu (which holds the toggle) opens from the button on this row. */
    .is-docs .site-header-theme {
      display: none;
    }
  }
  /* A phone: the brand, version and toggle still share the first row. */
  @media (max-width: 29.99rem) {
    .brand {
      gap: 0.5rem;
    }
    .brand :global(.mark) {
      width: 24px;
      height: 24px;
    }
    .wordmark {
      font-size: 1.25rem;
    }
    .site-version {
      padding-inline: 0.375rem;
      font-size: 0.625rem;
    }
  }
</style>
