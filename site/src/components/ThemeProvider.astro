---
/**
 * Replaces Starlight's ThemeProvider (plan §9, D11). The visitor chooses System, Light or Dark;
 * System follows prefers-color-scheme and keeps following it. This runs in <head> before the
 * first paint, so the page never flashes the wrong theme (uisite-02). Storage is optional:
 * reading or writing it may throw (blocked site data, sandboxed frames), and then the choice
 * lasts for the page only (uisite-01). The key is new, so stale 'dark' values from the old site
 * never pin a visitor.
 */
import { Icon } from '@astrojs/starlight/components';
---

<script is:inline>
  window.SnaplotTheme = (() => {
    const key = 'snaplot-site-theme-v2';
    const dark = matchMedia('(prefers-color-scheme: dark)');
    const parse = (value) => (value === 'light' || value === 'dark' ? value : 'auto');
    let choice = 'auto';
    try {
      choice = parse(localStorage.getItem(key));
    } catch {}
    const apply = () => {
      const theme = choice === 'auto' ? (dark.matches ? 'dark' : 'light') : choice;
      document.documentElement.dataset.theme = theme;
      document.documentElement.dataset.themeChoice = choice;
    };
    const sync = () => {
      const icon = document.querySelector('#theme-icons')?.content.querySelector('.' + choice);
      for (const picker of document.querySelectorAll('snaplot-theme-select')) {
        const select = picker.querySelector('select');
        if (select) select.value = choice;
        const current = picker.querySelector('svg.label-icon');
        if (icon && current) current.replaceChildren(...icon.cloneNode(true).childNodes);
      }
    };
    dark.addEventListener('change', () => {
      if (choice === 'auto') apply();
    });
    apply();
    return {
      sync,
      get: () => choice,
      set(value) {
        choice = parse(value);
        try {
          if (choice === 'auto') localStorage.removeItem(key);
          else localStorage.setItem(key, choice);
        } catch {}
        apply();
        sync();
      },
    };
  })();
</script>

<template id="theme-icons">
  <Icon name="sun" class="light" />
  <Icon name="moon" class="dark" />
  <Icon name="laptop" class="auto" />
</template>
