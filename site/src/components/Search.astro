---
/**
 * Replaces Starlight's Search (uisite-14, docs-11). Starlight's button and modal dialog stay; the
 * dialog holds an ARIA combobox over Pagefind's full-text index (prose, headings, code and the
 * API reference) instead of Pagefind's default UI, which has no combobox semantics. The results
 * are a listbox inside the modal dialog, which sits in the top layer, so no page content can
 * cover them.
 */
import { Icon } from '@astrojs/starlight/components';
---

<site-search class={Astro.props.class} data-base={import.meta.env.BASE_URL}>
  <button data-open-modal disabled aria-label="Search" aria-keyshortcuts="Control+K">
    <Icon name="magnifier" />
    <span class="sl-hidden md:sl-block" aria-hidden="true">Search</span>
    <kbd class="sl-hidden md:sl-flex" hidden><kbd>Ctrl</kbd><kbd>K</kbd></kbd>
  </button>

  <dialog aria-label="Search the docs">
    <div class="dialog-frame">
      <div class="search-bar">
        <label class="sr-only" for="snaplot-search-input">Search the docs</label>
        <input
          id="snaplot-search-input"
          type="search"
          role="combobox"
          aria-expanded="false"
          aria-controls="snaplot-search-results"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
          placeholder="Search the docs"
        />
        <button type="button" data-close-modal>Close</button>
      </div>
      <p class="search-status" role="status" aria-live="polite"></p>
      <ul id="snaplot-search-results" role="listbox" aria-label="Results"></ul>
    </div>
  </dialog>
</site-search>

{/* Inline, so the shortcut hint never shows the wrong key. */}
<script is:inline>
  (() => {
    const button = document.querySelector('site-search button[data-open-modal]');
    const hint = button && button.querySelector('kbd');
    if (!hint) return;
    if (/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
      hint.querySelector('kbd').textContent = '⌘';
      button.setAttribute('aria-keyshortcuts', 'Meta+K');
    }
    hint.hidden = false;
  })();
</script>

<script>
  interface PagefindSubResult {
    title: string;
    url: string;
    excerpt: string;
  }
  interface PagefindData {
    url: string;
    excerpt: string;
    meta: { title?: string };
    sub_results?: PagefindSubResult[];
  }
  interface Pagefind {
    search(query: string): Promise<{ results: { data(): Promise<PagefindData> }[] } | null>;
    debouncedSearch?(query: string, options?: object, ms?: number): Promise<unknown>;
  }

  const MAX_PAGES = 8;
  const MAX_SECTIONS = 2;

  /** Pagefind excerpts are escaped text with <mark> around the hits; keep only those marks. */
  function excerptNodes(excerpt: string): Node[] {
    const nodes: Node[] = [];
    const parts = excerpt.split(/(<mark>.*?<\/mark>)/g);
    const decode = (html: string) =>
      new DOMParser().parseFromString(`<!doctype html><body>${html}`, 'text/html').body
        .textContent ?? '';
    for (const part of parts) {
      const mark = /^<mark>(.*?)<\/mark>$/.exec(part);
      if (mark) {
        const el = document.createElement('mark');
        el.textContent = decode(mark[1] ?? '');
        nodes.push(el);
      } else if (part) {
        nodes.push(document.createTextNode(decode(part)));
      }
    }
    return nodes;
  }

  class SiteSearch extends HTMLElement {
    #dialog!: HTMLDialogElement;
    #input!: HTMLInputElement;
    #list!: HTMLUListElement;
    #status!: HTMLElement;
    #pagefind: Promise<Pagefind | null> | undefined;
    #active = -1;
    #query = 0;

    connectedCallback(): void {
      const open = this.querySelector<HTMLButtonElement>('button[data-open-modal]')!;
      const close = this.querySelector<HTMLButtonElement>('button[data-close-modal]')!;
      this.#dialog = this.querySelector('dialog')!;
      this.#input = this.querySelector('input')!;
      this.#list = this.querySelector('[role="listbox"]')!;
      this.#status = this.querySelector('[role="status"]')!;

      open.addEventListener('click', (event) => {
        event.stopPropagation();
        this.open();
      });
      open.disabled = false;
      close.addEventListener('click', () => this.#dialog.close());
      // A click on the backdrop (the dialog element itself) closes it.
      this.#dialog.addEventListener('click', (event) => {
        if (event.target === this.#dialog) this.#dialog.close();
      });
      this.#dialog.addEventListener('close', () => {
        document.body.toggleAttribute('data-search-modal-open', false);
      });
      window.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key === 'k') {
          event.preventDefault();
          if (this.#dialog.open) this.#dialog.close();
          else this.open();
        }
      });
      this.#input.addEventListener('input', () => void this.#search(this.#input.value));
      this.#input.addEventListener('keydown', (event) => this.#onKey(event));
      this.#list.addEventListener('click', (event) => {
        const option = (event.target as Element).closest<HTMLElement>('[role="option"]');
        if (option?.dataset.url) this.#go(option.dataset.url);
      });
    }

    open(): void {
      this.#dialog.showModal();
      document.body.toggleAttribute('data-search-modal-open', true);
      this.#input.focus();
      this.#input.select();
      this.#load();
    }

    #load(): Promise<Pagefind | null> {
      this.#pagefind ??= (async () => {
        const base = (this.dataset.base ?? '/').replace(/\/?$/, '/');
        try {
          const url = `${base}pagefind/pagefind.js`;
          return (await import(/* @vite-ignore */ url)) as Pagefind;
        } catch {
          this.#status.textContent = import.meta.env.DEV
            ? 'Search works in the production build: npm run build:site, then npm run preview -w site.'
            : 'Search is unavailable.';
          return null;
        }
      })();
      return this.#pagefind;
    }

    async #search(query: string): Promise<void> {
      const id = ++this.#query;
      const pagefind = await this.#load();
      if (!pagefind || id !== this.#query) return;
      if (!query.trim()) {
        this.#render([]);
        this.#status.textContent = '';
        return;
      }
      const search = await pagefind.search(query);
      if (!search || id !== this.#query) return;
      const pages = await Promise.all(search.results.slice(0, MAX_PAGES).map((r) => r.data()));
      if (id !== this.#query) return;
      this.#render(pages);
      const n = search.results.length;
      this.#status.textContent = n === 0 ? `No results for “${query}”` : `${n} ${n === 1 ? 'page' : 'pages'}`;
    }

    #render(pages: PagefindData[]): void {
      const options: HTMLLIElement[] = [];
      const option = (title: string, excerpt: string, url: string, section: boolean) => {
        const li = document.createElement('li');
        li.id = `snaplot-search-option-${options.length}`;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', 'false');
        li.dataset.url = url;
        if (section) li.dataset.section = '';
        const heading = document.createElement('span');
        heading.className = 'result-title';
        heading.textContent = title;
        const text = document.createElement('span');
        text.className = 'result-excerpt';
        text.append(...excerptNodes(excerpt));
        li.append(heading, text);
        options.push(li);
      };
      for (const page of pages) {
        option(page.meta.title ?? page.url, page.excerpt, page.url, false);
        const sections = (page.sub_results ?? []).filter((s) => s.url !== page.url);
        for (const sub of sections.slice(0, MAX_SECTIONS)) option(sub.title, sub.excerpt, sub.url, true);
      }
      this.#list.replaceChildren(...options);
      this.#input.setAttribute('aria-expanded', String(options.length > 0));
      this.#setActive(options.length > 0 ? 0 : -1);
    }

    #setActive(index: number): void {
      const options = [...this.#list.querySelectorAll<HTMLElement>('[role="option"]')];
      this.#active = index;
      options.forEach((o, i) => o.setAttribute('aria-selected', String(i === index)));
      const active = options[index];
      if (active) {
        this.#input.setAttribute('aria-activedescendant', active.id);
        active.scrollIntoView({ block: 'nearest' });
      } else {
        this.#input.removeAttribute('aria-activedescendant');
      }
    }

    #onKey(event: KeyboardEvent): void {
      const count = this.#list.children.length;
      if (event.key === 'ArrowDown' && count > 0) {
        event.preventDefault();
        this.#setActive((this.#active + 1) % count);
      } else if (event.key === 'ArrowUp' && count > 0) {
        event.preventDefault();
        this.#setActive((this.#active - 1 + count) % count);
      } else if (event.key === 'Enter') {
        const active = this.#list.children[this.#active] as HTMLElement | undefined;
        if (active?.dataset.url) {
          event.preventDefault();
          this.#go(active.dataset.url);
        }
      } else if (event.key === 'Escape' && this.#input.value) {
        // The first Escape clears the query; the next one closes the dialog.
        event.preventDefault();
        this.#input.value = '';
        void this.#search('');
      }
    }

    #go(url: string): void {
      this.#dialog.close();
      window.location.assign(url);
    }
  }
  customElements.define('site-search', SiteSearch);
</script>

<style>
  site-search {
    display: contents;
  }
  button[data-open-modal] {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 0;
    background-color: transparent;
    color: var(--snaplot-ink);
    cursor: pointer;
    height: 2.5rem;
    font-size: var(--sl-text-xl);
  }
  @media (min-width: 50rem) {
    button[data-open-modal] {
      border: 1px solid var(--snaplot-rule);
      border-radius: var(--snaplot-radius);
      padding-inline: 0.75rem 0.5rem;
      background-color: var(--snaplot-background);
      color: var(--snaplot-ink-secondary);
      font-size: var(--sl-text-sm);
      width: 100%;
      max-width: 22rem;
    }
    button[data-open-modal]:hover {
      border-color: var(--snaplot-ink-secondary);
      color: var(--snaplot-ink);
    }
    button[data-open-modal] > :last-child {
      margin-inline-start: auto;
    }
  }
  button > kbd {
    display: flex;
    gap: 0.25em;
    border-radius: 0.25rem;
    font-size: var(--sl-text-2xs);
    padding-inline: 0.375rem;
    background-color: var(--snaplot-surface);
  }
  button > kbd[hidden] {
    display: none;
  }
  dialog {
    margin: 0;
    padding: 0;
    border: 1px solid var(--snaplot-rule);
    background-color: var(--snaplot-background);
    color: var(--snaplot-ink);
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
  }
  dialog::backdrop {
    background-color: var(--sl-color-backdrop-overlay);
  }
  .dialog-frame {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    height: 100%;
  }
  .search-bar {
    display: flex;
    gap: 0.5rem;
  }
  input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: var(--sl-text-base);
    color: var(--snaplot-ink);
    background-color: var(--snaplot-background);
    border: 1px solid var(--snaplot-rule);
    border-radius: var(--snaplot-radius);
    padding: 0.5rem 0.75rem;
  }
  input:hover {
    border-color: var(--snaplot-ink-secondary);
  }
  button[data-close-modal] {
    font: inherit;
    font-size: var(--sl-text-sm);
    color: var(--snaplot-ink);
    background: none;
    border: 1px solid var(--snaplot-rule);
    border-radius: var(--snaplot-radius);
    padding-inline: 0.75rem;
    cursor: pointer;
  }
  button[data-close-modal]:hover {
    background-color: var(--snaplot-surface);
  }
  .search-status {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--snaplot-ink-secondary);
  }
  .search-status:empty {
    display: none;
  }
  [role='listbox'] {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
  }
  [role='option'] {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--snaplot-radius);
    cursor: pointer;
  }
  [role='option'][data-section] {
    padding-inline-start: 1.75rem;
  }
  [role='option']:hover,
  [role='option'][aria-selected='true'] {
    background-color: var(--snaplot-surface);
  }
  [role='option'][aria-selected='true'] .result-title {
    color: var(--snaplot-accent);
  }
  .result-title {
    font-weight: 600;
  }
  .result-excerpt {
    font-size: var(--sl-text-sm);
    color: var(--snaplot-ink-secondary);
  }
  .result-excerpt :global(mark) {
    background: none;
    color: var(--snaplot-ink);
    font-weight: 600;
  }
  @media (min-width: 50rem) {
    dialog {
      margin: 4rem auto auto;
      border-radius: var(--snaplot-radius);
      width: 90%;
      max-width: 40rem;
      height: max-content;
      min-height: 15rem;
      max-height: calc(100% - 8rem);
    }
  }
</style>
