---
/** Replaces Starlight's SiteTitle: the name, then the version the docs describe (docs-16). */
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import { version } from '../lib/version';
---

<span class="site-title-row">
  <Default />
  <span class="site-version num" data-version={version}>v{version}</span>
</span>

<style>
  .site-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
  }
  .site-version {
    font-size: 0.875rem;
    color: var(--snaplot-ink-secondary);
    white-space: nowrap;
  }
</style>
