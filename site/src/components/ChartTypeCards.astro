---
/**
 * The chart types as a grid of pictures, each a still, live chart of the type's first recipe and a
 * link to its page (chart-types/index.mdx). The pictures are the charts themselves, readonly and
 * hidden from assistive technology: the link names the type, and its page has the charts.
 */
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const TYPES = [
  {
    slug: 'line',
    title: 'Line',
    example: 'chart-types/line',
    text: 'Values joined in X order, straight, smooth or stepped.',
  },
  {
    slug: 'area',
    title: 'Area',
    example: 'chart-types/area-zero',
    text: 'A line filled to zero, above it and below it.',
  },
  {
    slug: 'band',
    title: 'Band',
    example: 'chart-types/band',
    text: 'A range between a lower and an upper value, with its centre.',
  },
  {
    slug: 'bar',
    title: 'Bar',
    example: 'chart-types/bar-grouped',
    text: 'A bar per X value; several series share each slot.',
  },
  {
    slug: 'scatter',
    title: 'Scatter',
    example: 'chart-types/scatter',
    text: 'Points coloured and sized by fields; a density map past 200,000.',
  },
  {
    slug: 'histogram',
    title: 'Histogram',
    example: 'chart-types/histogram',
    text: 'Counts of values in bins on nice edges.',
  },
];
---

<ul class="chart-types not-content">
  {
    TYPES.map((type) => (
      <li>
        <snaplot-vanilla-mount
          class="chart-type-picture"
          data-name={type.example}
          data-kind="options"
          data-still
          aria-hidden="true"
        />
        <h3>
          <a href={`${base}chart-types/${type.slug}/`}>{type.title}</a>
        </h3>
        <p>{type.text}</p>
      </li>
    ))
  }
</ul>

<style>
  /* The overview has no table of contents: its content takes the room, up to three cards wide. */
  :global(.main-pane:has(ul.chart-types) .sl-container) {
    max-width: 64rem;
  }
  ul.chart-types {
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: 1.75rem 0 2.5rem;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    ul.chart-types {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 80rem) {
    ul.chart-types {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  ul.chart-types > li {
    position: relative;
    margin: 0;
    padding: 0.5rem 0.5rem 1.125rem;
    border: 1px solid var(--snaplot-rule);
    border-radius: var(--snaplot-radius-md);
    background-color: var(--snaplot-raised);
    box-shadow: var(--snaplot-shadow-sm);
    transition:
      transform 220ms var(--snaplot-ease),
      box-shadow 220ms var(--snaplot-ease),
      border-color 220ms var(--snaplot-ease);
  }
  ul.chart-types > li:hover {
    transform: translateY(-3px);
    border-color: var(--snaplot-rule-strong);
    box-shadow: var(--snaplot-shadow-md);
  }
  @media (prefers-reduced-motion: reduce) {
    ul.chart-types > li {
      transition: none;
    }
    ul.chart-types > li:hover {
      transform: none;
    }
  }
  /* The picture sits in a well, which also holds its place until the chart mounts on sight. */
  .chart-type-picture {
    display: block;
    height: 190px;
    padding: 0.5rem 0.5rem 0;
    border-radius: var(--snaplot-radius-sm);
    background-color: var(--snaplot-surface);
  }
  ul.chart-types h3 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 1rem 0.625rem 0.25rem;
    font-family: var(--snaplot-font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  ul.chart-types h3 a {
    color: var(--snaplot-ink);
    text-decoration: none;
  }
  /* The whole card is the link. */
  ul.chart-types h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  ul.chart-types h3::after {
    content: '→' / '';
    color: var(--snaplot-accent);
    font-family: var(--snaplot-font);
    font-size: 1rem;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 160ms ease,
      transform 160ms var(--snaplot-ease);
  }
  ul.chart-types > li:hover h3::after {
    opacity: 1;
    transform: none;
  }
  ul.chart-types > li:hover h3 a,
  ul.chart-types h3 a:focus-visible {
    color: var(--snaplot-accent);
  }
  ul.chart-types p {
    margin: 0 0.625rem;
    color: var(--snaplot-ink-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>

<script>
  import { defineVanillaMount } from '../lib/vanilla-mount';

  defineVanillaMount();
</script>
