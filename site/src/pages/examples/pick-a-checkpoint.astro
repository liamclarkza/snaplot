---
/**
 * R1 "Which checkpoint should we ship?" (plan §10.2): a React demo on its own page, with its own
 * layout and its one webfont, Roboto. No Starlight chrome; only the thin examples footer is
 * shared. The data is fetched by the island from public/data/pick-a-checkpoint/.
 */
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import '../../demos/pick-a-checkpoint/style.css';
import PickACheckpoint from '../../demos/pick-a-checkpoint/main.react';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const source = 'https://github.com/liamclarkza/snaplot/tree/main/site/src/demos/pick-a-checkpoint';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>Which checkpoint should we ship? · snaplot examples</title>
    <meta
      name="description"
      content="Two training runs of a handwritten-digit classifier compared epoch by epoch, with a decision panel that computes which checkpoint to ship."
    />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:image" content={new URL(`${base}examples/pick-a-checkpoint.jpg`, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="r1">
    <header class="r1-header">
      <h1>Which checkpoint should we ship?</h1>
      <p class="r1-meta">
        Two training runs of a handwritten-digit classifier · 64-32-10 network, 60 epochs per run · trained on 3,823 and validated on 1,797 UCI digits ·
        logs generated 2026-10-23 by <code>scripts/demo-data/train-digits.mjs</code>
      </p>
    </header>
    <main class="r1-main">
      <PickACheckpoint client:only="react">
        <p slot="fallback">Loading the training logs. This page needs JavaScript.</p>
      </PickACheckpoint>
    </main>
    <footer class="r1-footer">
      <a href={`${base}examples/`}>← Examples</a> · <a href={source}>Source</a> · Data: E. Alpaydin and C. Kaynak, Optical Recognition of Handwritten Digits, UCI Machine Learning Repository, doi:10.24432/C50P49 (CC BY 4.0 input; MIT logs)
    </footer>
  </body>
</html>
