---
/**
 * S2 "Did deploy #482 cause the p99 spike?" (plan §10.2): a Solid incident dashboard with its own
 * layout and no Starlight chrome. The data is a seeded simulator, labelled on the page; the
 * footer's attribution line is read from its SOURCE.md.
 */
import Dashboard from '../../demos/deploy-482/main.solid';
import '../../demos/deploy-482/dashboard.css';
import source from '../../../public/data/deploy-482/SOURCE.md?raw';

const section = (name: string) =>
  new RegExp(`^## ${name}\\n+(.+)$`, 'm').exec(source)?.[1]?.trim() ?? '';
const attribution = section('Attribution');
// "MIT (generated)" reads "MIT, generated" inside the footer's own parentheses.
const licence = section('Licence').replace(/\s*\(([^)]+)\)$/, ', $1');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const SOURCE_URL = 'https://github.com/liamclarkza/snaplot/tree/main/site/src/demos/deploy-482';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>Did deploy #482 cause the p99 spike? · snaplot examples</title>
    <meta
      name="description"
      content="An incident dashboard on a simulated service: did a deploy cause a latency spike, and should it be rolled back? Solid with snaplot."
    />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:image" content={new URL(`${base}examples/deploy-482.jpg`, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main id="main">
      <Dashboard client:only="solid-js" />
    </main>
    <footer class="demo-footer">
      <a href={`${base}examples/`}>← Examples</a> · <a href={SOURCE_URL}>Source</a> · <span
        >Data: <span data-attribution>{attribution}</span> ({licence})</span
      >
    </footer>
  </body>
</html>
