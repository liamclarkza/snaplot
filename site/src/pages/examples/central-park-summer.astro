---
/**
 * V2, "Was summer 2025 unusually hot in Central Park?" (plan §10.2): a vanilla page in the manner
 * of the newspaper weather chart Tufte reproduces. The question is the headline and the answer
 * the standfirst; one long chart, a one-line reading key and almost no UI. The chart is made by
 * src/demos/central-park-summer/main.ts.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import '@fontsource/libre-caslon-text/latin-400.css';
import '@fontsource/libre-caslon-text/latin-400-italic.css';
import '@fontsource/libre-caslon-text/latin-700.css';
import '@fontsource/libre-franklin/latin-400.css';
import '@fontsource/libre-franklin/latin-600.css';
import '../../demos/central-park-summer/page.css';

const slug = 'central-park-summer';
const source = readFileSync(join(process.cwd(), `public/data/${slug}/SOURCE.md`), 'utf8');
/** The first line under a `## <name>` heading of SOURCE.md. */
const field = (name: string) =>
  new RegExp(`^## ${name}\\n+(.+)$`, 'm').exec(source)?.[1]?.trim() ?? '';
const attribution = field('Attribution');
const licence = field('Licence');
const retrieved = new Date(`${field('Retrieved')}T00:00:00Z`).toLocaleDateString('en-US', {
  timeZone: 'UTC',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = 'https://github.com/liamclarkza/snaplot/tree/main';
const page = new URL(Astro.url.pathname, Astro.site).href;
const question = 'Was summer 2025 unusually hot in Central Park?';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{question} · snaplot examples</title>
    <meta
      name="description"
      content="Daily highs and lows in Central Park, June to August 2025, against the normal and record ranges, from NOAA NCEI GHCN-Daily."
    />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={page} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="snaplot" />
    <meta property="og:title" content={question} />
    <meta property="og:url" content={page} />
    <meta property="og:image" content={new URL(`${base}examples/${slug}.jpg`, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main class="paper" data-demo={slug}>
      <header class="story-head">
        <h1>{question}</h1>
        <p class="standfirst" data-part="answer">Loading the station record…</p>
        <p class="byline">
          {
            [
              'Central Park, New York',
              'daily readings, June 1 to August 31, 2025',
              'NOAA station USW00094728',
              `record retrieved ${retrieved}`,
            ].join(' · ')
          }
        </p>
      </header>

      <figure class="weather">
        <figcaption class="key" data-part="key"></figcaption>
        <div class="chart" data-part="chart"></div>
        <p class="notes">
          Records cover 1869 to 2024. The normal range spans the 10th to the 90th percentile of daily
          highs within a week either side of the date, 1991 to 2020.{' '}
          <span class="hint-mouse">Point at a day to read its numbers.</span>
          <span class="hint-touch">Tap a day to read its numbers.</span>
        </p>
      </figure>

      <p class="records" data-part="records"></p>
    </main>

    <footer class="demo-footer">
      <a href={`${base}examples/`}>← Examples</a>{' · '}
      <a href={`${repo}/site/src/demos/${slug}`}>Source</a>{' · '}
      <span data-attribution>Data: {attribution} ({licence})</span>
    </footer>

    <script>
      import { mount } from '../../demos/central-park-summer/main';

      const root = document.querySelector<HTMLElement>('[data-demo]');
      // The chart is on `window.demo` for the page's tests and for anyone at the console.
      if (root) void mount(root).then((chart) => Object.assign(window, { demo: chart }));
    </script>
  </body>
</html>
