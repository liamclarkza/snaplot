---
/**
 * The examples hub (plan §10.3): an index, not a landing page. One sentence, then one row per
 * example (two a line on wide screens): its question, who decides what with it, a thumbnail Playwright took of the real page
 * (`npm run thumbs`), the dataset with its licence and size, the framework, and Open and Source
 * links. No hero, statistics or call to action.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Site from '../../layouts/Site.astro';
import { DEMOS, sourceUrl } from '../../lib/demos';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
/** The social card, written by `npm run thumbs` (uisite-20). */
const card = new URL(`${base}examples/social-card.jpg`, Astro.site).href;
const examples = DEMOS.map((demo) => ({
  ...demo,
  page: existsSync(join(process.cwd(), `src/pages/examples/${demo.slug}.astro`)),
  thumbnail: existsSync(join(process.cwd(), `public/examples/${demo.slug}.jpg`)),
}));
---

<Site
  title="Examples · snaplot"
  description="Each example answers one question with real or documented data."
  current="examples"
>
  <Fragment slot="head">
    <meta property="og:image" content={card} />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>
  <h1>Examples</h1>
  <p class="intro">
    Each example answers one question with real or documented data; for one chart type at a time,
    with its code, see <a href={`${base}chart-types/`}>Chart types</a>.
  </p>
  <ul class="examples">
    {
      examples.map((demo) => (
        <li data-demo={demo.slug} data-framework={demo.framework}>
          {demo.thumbnail ? (
            <picture>
              {/* A phone shows a close-up of the page's main chart: the whole page cannot be read
                  at its width. */}
              <source
                media="(max-width: 39.99rem)"
                srcset={`${base}examples/${demo.slug}-close.jpg 640w, ${base}examples/${demo.slug}-close@2x.jpg 1280w`}
                sizes="100vw"
              />
              <img
                class="thumb"
                src={`${base}examples/${demo.slug}.jpg`}
                srcset={`${base}examples/${demo.slug}.jpg 640w, ${base}examples/${demo.slug}@2x.jpg 1280w`}
                sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
                alt=""
                width="320"
                height="200"
                loading="lazy"
                decoding="async"
              />
            </picture>
          ) : (
            <span class="thumb thumb-missing" />
          )}
          <div class="row-text">
            <h2 class="demo-question">
              {demo.page ? <a href={`${base}examples/${demo.slug}/`}>{demo.question}</a> : demo.question}
            </h2>
            <p>{demo.task}</p>
            <p class="demo-meta">
              {demo.dataset} · {demo.licence} · <span class="num">{demo.rows}</span>
            </p>
            <p class="demo-links">
              <span class="badge" data-framework={demo.framework}>
                {demo.framework}
              </span>
              {demo.page && <a href={`${base}examples/${demo.slug}/`}>Open</a>}
              <a href={sourceUrl(demo.slug)}>Source</a>
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</Site>

<style>
  .intro {
    margin: -0.5rem 0 2.5rem;
    color: var(--snaplot-ink-secondary);
    font-size: 1.125rem;
  }
  /* A grid of examples: each a picture, its question, who it is for and its data. The whole item
     is the link to the page; Source sits above that link. */
  ul.examples {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The home page's grid steps: two columns from 40rem, three from 64rem. */
  @media (min-width: 40rem) {
    ul.examples {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    ul.examples {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* Each item the height of its row, its links at the foot, so a row's links line up. */
  ul.examples > li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  ul.examples picture {
    display: block;
  }
  .row-text {
    display: flex;
    flex: 1;
    flex-direction: column;
  }
  .thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--snaplot-rule);
    border-radius: var(--snaplot-radius);
    transition: border-color 120ms ease;
  }
  /* The light pages' pictures sit a little dimmer on a dark page. */
  :global(:root[data-theme='dark']) .thumb {
    filter: brightness(0.88);
  }
  /* A demo whose page has not been built yet keeps its place, without a stand-in picture. */
  .thumb-missing {
    border-color: transparent;
  }
  .demo-question {
    margin: 0 0 0.375rem;
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .demo-question a {
    color: var(--snaplot-ink);
    text-decoration: none;
  }
  .demo-question a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  ul.examples > li:hover .thumb {
    border-color: var(--snaplot-ink-secondary);
  }
  ul.examples > li:hover .demo-question a,
  .demo-question a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .row-text p {
    margin: 0 0 0.375rem;
  }
  .demo-meta {
    font-size: 0.8125rem;
  }
  .row-text .demo-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    margin-top: auto;
    padding-top: 0.625rem;
    font-size: 0.8125rem;
  }
  /* Open repeats the question's link; it stays for keyboards and readers, quietly. */
  .demo-links a {
    position: relative;
    z-index: 1;
    padding-block: 0.375rem;
    color: var(--snaplot-ink-secondary);
  }
  .demo-links a:hover {
    color: var(--snaplot-ink);
  }
  /* The framework: a quiet label with the framework's own colour as a dot. */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
    background-color: var(--snaplot-surface);
    color: var(--snaplot-ink);
    font-weight: 500;
  }
  .badge::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 4px;
    background-color: var(--framework, var(--snaplot-ink-secondary));
  }
  .badge[data-framework='Vanilla JS'] {
    --framework: #c9a400;
  }
  .badge[data-framework='React'] {
    --framework: #0a7ea4;
  }
  .badge[data-framework='Solid'] {
    --framework: #2c4f7c;
  }
  :global(:root[data-theme='dark']) .badge[data-framework='Vanilla JS'] {
    --framework: #f0db4f;
  }
  :global(:root[data-theme='dark']) .badge[data-framework='React'] {
    --framework: #61dafb;
  }
  :global(:root[data-theme='dark']) .badge[data-framework='Solid'] {
    --framework: #7fa6dc;
  }
</style>
