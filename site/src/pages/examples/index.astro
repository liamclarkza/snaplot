---
/**
 * The examples hub (plan §10.3): an index. One heading and one sentence, then a card per example
 * (three a row on wide screens): a thumbnail Playwright took of the real page (`npm run thumbs`),
 * its question, who decides what with it, the dataset with its licence and size, the framework,
 * and Open and Source links.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Site from '../../layouts/Site.astro';
import { DEMOS, sourceUrl } from '../../lib/demos';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
/** The social card, written by `npm run thumbs` (uisite-20). */
const card = new URL(`${base}examples/social-card.jpg`, Astro.site).href;
const examples = DEMOS.map((demo) => ({
  ...demo,
  page: existsSync(join(process.cwd(), `src/pages/examples/${demo.slug}.astro`)),
  thumbnail: existsSync(join(process.cwd(), `public/examples/${demo.slug}.jpg`)),
}));
---

<Site
  title="Examples · snaplot"
  description="Each example answers one question with real or documented data."
  current="examples"
>
  <Fragment slot="head">
    <meta property="og:image" content={card} />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>
  <h1>Examples</h1>
  <p class="intro">
    Each example answers one question with real or documented data; for one chart type at a time,
    with its code, see <a href={`${base}chart-types/`}>Chart types</a>.
  </p>
  <ul class="examples">
    {
      examples.map((demo) => (
        <li class="demo-card" data-demo={demo.slug} data-framework={demo.framework}>
          {demo.thumbnail ? (
            <picture class="demo-card-picture">
              {/* A phone shows a close-up of the page's main chart: the whole page cannot be read
                  at its width. */}
              <source
                media="(max-width: 39.99rem)"
                srcset={`${base}examples/${demo.slug}-close.jpg 640w, ${base}examples/${demo.slug}-close@2x.jpg 1280w`}
                sizes="100vw"
              />
              <img
                class="thumb"
                src={`${base}examples/${demo.slug}.jpg`}
                srcset={`${base}examples/${demo.slug}.jpg 640w, ${base}examples/${demo.slug}@2x.jpg 1280w`}
                sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
                alt=""
                width="320"
                height="200"
                loading="lazy"
                decoding="async"
              />
            </picture>
          ) : (
            <span class="demo-card-picture thumb-missing" />
          )}
          <div class="row-text demo-card-body">
            <h2 class="demo-question">
              {demo.page ? <a href={`${base}examples/${demo.slug}/`}>{demo.question}</a> : demo.question}
            </h2>
            <p class="demo-task">{demo.task}</p>
            <p class="demo-meta">
              {demo.dataset} · {demo.licence} · <span class="num">{demo.rows}</span>
            </p>
            <p class="demo-links">
              <span class="badge framework" data-framework={demo.framework}>
                {demo.framework}
              </span>
              <span class="demo-link-group">
                {demo.page && <a href={`${base}examples/${demo.slug}/`}>Open</a>}
                <a href={sourceUrl(demo.slug)}>Source</a>
              </span>
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</Site>

<style>
  h1 {
    margin-top: clamp(0.5rem, 3vw, 2.5rem);
    font-size: clamp(3.25rem, 1.5rem + 7vw, 7rem);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }
  .intro {
    max-width: 52ch;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
    color: var(--snaplot-ink-secondary);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.45;
  }
  /* A grid of cards: each a picture, its question, who it is for and its data. The whole card is
     the link to the page; Open and Source sit above that link. */
  ul.examples {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The home page's grid steps: two columns from 40rem, three from 64rem. */
  @media (min-width: 40rem) {
    ul.examples {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    ul.examples {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* A demo whose page has not been built yet keeps its place, without a stand-in picture. */
  .thumb-missing {
    aspect-ratio: 8 / 5;
  }
  .demo-question {
    margin: 0 0 0.5rem;
    font-size: 1.375rem;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
  .row-text p {
    margin: 0 0 0.375rem;
  }
  .demo-task {
    font-size: 0.9375rem;
  }
  .demo-meta {
    font-size: 0.8125rem;
  }
  .row-text .demo-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.8125rem;
  }
  .demo-link-group {
    display: inline-flex;
    gap: 0.375rem;
  }
  /* Open repeats the question's link; it stays for keyboards and readers, as a small pill. */
  .demo-links a {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.125rem 0.75rem;
    border: 1px solid var(--snaplot-rule);
    border-radius: var(--snaplot-radius-pill);
    color: var(--snaplot-ink-secondary);
    font-weight: 500;
    text-decoration: none;
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }
  .demo-links a:hover {
    border-color: var(--snaplot-ink-secondary);
    color: var(--snaplot-ink);
  }
  .badge {
    padding: 0.1875rem 0.625rem;
    border-radius: var(--snaplot-radius-pill);
    background-color: var(--snaplot-surface);
  }
</style>
