  "types": [
    {
      "name": "ThemeConfig",
      "kind": "interface",
      "doc": "Chart color and typography tokens. Every color field accepts any CSS color the browser can compute, including `var(--token)` references and `oklch(...)`: values are resolved against the chart container when the theme is applied, and re-resolved automatically when the document theme changes (an attribute flip on `<html>`/`<body>` or an OS color-scheme change), so charts in a CSS-variable design system re-theme live with no remount. Alternatively define the `--chart-*` custom properties (see `CHART_CSS_VARS`) on the container and omit `theme` entirely."
    },
    {
      "name": "ChartStats",
      "kind": "interface",
      "doc": ""
    },
    {
      "name": "DebugConfig",
      "kind": "interface",
      "doc": ""
    },
    {
      "name": "CursorSnapshotOptions",
      "kind": "interface",
      "doc": "Options accepted by `getCursorSnapshot()` and the reactive primitive."
    },
    {
      "name": "CursorSnapshot",
      "kind": "interface",
      "doc": ""
    },
    {
      "name": "LegendItem",
      "kind": "interface",
      "doc": ""
    },
    {
      "name": "SelectionResult",
      "kind": "interface",
      "doc": ""
    },
    {
      "name": "SelectionRange",
      "kind": "interface",
      "doc": "A persistent brush selection in data space, safe to serialize (e.g. into a URL). `x` is always present; `y` is reserved for a future 2D brush."
    },
    {
      "name": "InteractionMode",
      "kind": "type",
      "doc": "Interaction modes define default gesture→action mappings: - timeseries: mouse drag=box-zoom, shift+drag=pan, pinch=zoom-x - analytical: mouse drag=box-zoom, shift+drag=pan, pinch=zoom-xy - readonly: tooltip only, all navigation disabled (reports, embeds) Touch defaults are cursor-first: one-finger drag moves the cursor, double-tap+drag selects, and two-finger pinch zooms."
    },
    {
      "name": "AxisTickMarksConfig",
      "kind": "interface",
      "doc": "Styling for the short marks that anchor tick labels to exact scale positions."
    },
    {
      "name": "AxisGridConfig",
      "kind": "interface",
      "doc": "Per-axis gridline styling, independent of tick labels. `false` (or `show: false`) removes this axis's gridlines while its labels stay; a time-bar chart often wants horizontal guides only, so set `axes.x.grid: false`. Colors here are concrete CSS color strings; theme `var()` references are resolved only in `ThemeConfig` fields."
    },
    {
      "name": "AxisPosition",
      "kind": "type",
      "doc": ""
    },
    {
      "name": "InterpolationMode",
      "kind": "type",
      "doc": "Line/area path interpolation. `monotone` is a shape-preserving cubic that never overshoots between points; the three `step-*` variants place the riser before, after, or centered on each point. Defaults to `linear`."
    },
    {
      "name": "ScatterColorEncodingType",
      "kind": "type",
      "doc": "How a `colorBy` column is interpreted. `auto` treats low-cardinality integer columns as categories and everything else as a continuous ramp."
    },
    {
      "name": "ScatterPointShape",
      "kind": "type",
      "doc": "Mark glyph for non-density scatter rendering. Defaults to `circle`."
    },
    {
      "name": "ScatterRenderMode",
      "kind": "type",
      "doc": "Scatter draw path. `points` always draws individual marks; `density` always draws a binned heatmap; `auto` (the default) draws points until the visible count crosses the internal density threshold, then switches."
    },
    {
      "name": "ChartType",
      "kind": "type",
      "doc": "Mark type for a series. Public bands name `lower` and `upper` fields; histogram series consume explicit binning results. Defaults to `line`."
    },
    {
      "name": "Layout",
      "kind": "interface",
      "doc": ""
    },
    {
      "name": "ScaleRange",
      "kind": "interface",
      "doc": "A closed data-space interval. `min` and `max` are in data units, not pixels."
