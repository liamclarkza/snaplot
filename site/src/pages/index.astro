---
/**
 * The homepage (plan §9, D34), in order: one sentence, the install string and one fact line, a
 * chart and code pair in three tabs (the hero, whose tabs show the files that run beside them),
 * the examples and the footer. There are no performance adjectives or benchmark numbers: the only
 * facts are the version, the measured gzip size of each entry point and the peer ranges
 * (gap-competitive-04).
 */
import { execFileSync } from 'node:child_process';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import Example from '../components/Example.astro';
import { Code } from '@astrojs/starlight/components';
import Site from '../layouts/Site.astro';
import { DEMOS } from '../lib/demos';
import routes from '../lib/old-routes.json';
import { dependencyCount, installCommand, version } from '../lib/version';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = join(process.cwd(), '..');
/** The social card, written by `npm run thumbs` (uisite-20). */
const card = new URL(`${base}examples/social-card.jpg`, Astro.site).href;

// The gzip size of each entry point, as an app that imports it pays (scripts/size.mjs, G6).
// size.mjs prints the sizes, then exits 1 when an import is over its budget (its stderr says
// which): the page still shows what was measured, and `npm run check:size` is the gate that fails.
type Size = { from: string; gzipBytes: number };
function measure(): Size[] {
  let printed: string | undefined;
  try {
    printed = execFileSync(process.execPath, [join(repo, 'scripts/size.mjs'), '--json'], {
      encoding: 'utf8',
    });
  } catch (error) {
    printed = (error as { stdout?: string }).stdout;
  }
  try {
    return JSON.parse(printed ?? '') as Size[];
  } catch (error) {
    throw new Error('homepage: `node scripts/size.mjs --json` printed no sizes', { cause: error });
  }
}
const sizes = measure();
const kb = (bytes: number) => `${(bytes / 1024).toFixed(1)} KB`;
const entrySizes = ['snaplot', 'snaplot/react', 'snaplot/solid'].map((entry) => {
  const measured = sizes.filter((row) => row.from === entry);
  return `${entry} ${kb(Math.max(...measured.map((row) => row.gzipBytes)))}`;
});

// "React 19" from `^19.0.0`, "React 18.3/19" from `^18.3.0 || ^19.0.0`.
const peers =
  (
    JSON.parse(readFileSync(join(repo, 'packages/snaplot/package.json'), 'utf8')) as {
      peerDependencies?: Record<string, string>;
    }
  ).peerDependencies ?? {};
const supported = (range = '') =>
  range
    .split('||')
    .map((part) => /(\d+)\.(\d+)/.exec(part))
    .filter((m) => m !== null)
    .map(([, major, minor]) => (minor === '0' ? major : `${major}.${minor}`))
    .join('/');

const facts = [
  `v${version}`,
  `gzipped: ${entrySizes.join(', ')}`,
  `${dependencyCount} dependencies`,
  `React ${supported(peers.react)}`,
  `Solid ${supported(peers['solid-js'])}`,
];

/** The hero's simulator is the deploy-482 example's; the caption links to it once it is built. */
const incident = existsSync(join(process.cwd(), 'src/pages/examples/deploy-482.astro'));

const examples = DEMOS.map((demo) => ({
  ...demo,
  page: existsSync(join(process.cwd(), `src/pages/examples/${demo.slug}.astro`)),
  thumbnail: existsSync(join(process.cwd(), `public/examples/${demo.slug}.jpg`)),
}));
---

<Site
  title="snaplot: canvas charts for live data"
  description="Canvas charts for live data. One options object for vanilla JS, React and Solid."
  current="home"
>
  <Fragment slot="head">
    <meta property="og:image" content={card} />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>
  <script slot="head" is:inline define:vars={{ routes, base }}>
    // Old hash links, /snaplot/#/docs/<group>/<section>, land on their new pages (plan §8.2).
    const route = /^#\/([^?#]*)/.exec(location.hash);
    if (route) {
      const [page, group, section] = route[1].split('/');
      const target =
        page === 'docs' && group
          ? (routes.docs[`${group}/${section}`] ?? routes.docs[group] ?? routes.pages.docs)
          : routes.pages[page];
      if (target) location.replace(base + target);
      else if (target === '') history.replaceState(null, '', base);
    }
  </script>

  <!-- One sentence pair (research-10): the claim large, the framework promise under it. -->
  <h1 class="lede">
    Canvas charts for live data. <span class="lede-sub"
      >One options object for vanilla JS, React and Solid.</span
    >
  </h1>
  <!-- The install string (D1), as a plain code line with its copy button: no terminal frame. -->
  <div class="install"><Code code={installCommand()} lang="sh" frame="none" /></div>
  <p class="facts num">{facts.join(' · ')}</p>

  <section class="hero" aria-labelledby="hero-title">
    <h2 id="hero-title" class="sr-only">A chart and its code</h2>
    <Example name="home/hero" />
    <p class="hero-caption">
      <button type="button" class="hero-toggle" data-hero-toggle>Pause</button>
      <span>
        A simulated service: the latency of its /search endpoint, ten seconds of data a second.
        Deploy #482 lands at 03:08 UTC.{' '}
        {
          incident ? (
            <a href={`${base}examples/deploy-482/`}>Did it cause the spike?</a>
          ) : (
            'Did it cause the spike?'
          )
        }
      </span>
    </p>
  </section>

  <h2 class="examples-title">Examples</h2>
  <p class="examples-intro">Each example answers one question with real or documented data.</p>
  <ul class="home-examples">
    {
      examples.map((demo) => (
        <li data-demo={demo.slug}>
          {demo.thumbnail && (
            <picture>
              {/* A phone shows a close-up of the page's main chart: the whole page cannot be read
                  at its width. */}
              <source
                media="(max-width: 39.99rem)"
                srcset={`${base}examples/${demo.slug}-close.jpg 640w, ${base}examples/${demo.slug}-close@2x.jpg 1280w`}
                sizes="100vw"
              />
              <img
                class="demo-thumb"
                src={`${base}examples/${demo.slug}.jpg`}
                srcset={`${base}examples/${demo.slug}.jpg 640w, ${base}examples/${demo.slug}@2x.jpg 1280w`}
                sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
                alt=""
                width="640"
                height="400"
                loading="lazy"
              />
            </picture>
          )}
          <div>
            <h3>
              {demo.page ? <a href={`${base}examples/${demo.slug}/`}>{demo.question}</a> : demo.question}
            </h3>
            <p class="demo-meta">
              {demo.framework} · {demo.dataset}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</Site>

<script>
  import { bindHeroToggle } from '../examples/data/latency-feed';

  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  if (toggle) bindHeroToggle(toggle);
</script>

<style>
  /* The sentence: the claim at display size, the framework promise under it in the body face. */
  .lede {
    max-width: none;
    margin-block: 1rem 1.75rem;
    font-size: clamp(2.5rem, 1.75rem + 3vw, 4.25rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .lede-sub {
    display: block;
    max-width: 44ch;
    margin-top: 1rem;
    color: var(--snaplot-ink-secondary);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0;
  }

  /* The install line as wide as its command, the facts beside it on a wide screen. */
  .install {
    inline-size: fit-content;
    min-inline-size: 16rem;
  }
  .facts {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
  }

  .hero {
    margin-top: 3rem;
  }

  /* The chart is the larger half, framed like its code and the same height; the chart first on a
     phone too. */
  @media (min-width: 64rem) {
    .hero :global(.example-panel:not([hidden])) {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 1.25rem;
      align-items: stretch;
      /* The frames start clear of the tabs' rule, so the two edges never sit 2px apart. */
      padding-top: 1rem;
    }
    .hero :global(.example-output) {
      padding: 1rem 1rem 0.75rem;
      border: 1px solid var(--snaplot-rule);
      border-radius: var(--snaplot-radius);
      background-color: var(--snaplot-background);
    }
    /* The code scrolls inside a frame the chart's height rather than running on below it. */
    .hero :global([data-example-code] pre) {
      max-height: 22rem;
      overflow: auto;
    }
  }

  /* The hero's code asks for 340px. The adapters do not size their host from `height` yet
     (frameworks-15, D26), so the islands' wrappers and the vanilla mount (sized for the docs'
     280px examples) take it here, or the chart runs over the code below it on a phone. */
  .hero :global(.example-island),
  .hero :global(.example-chart) {
    height: 340px;
  }
  .hero :global(.example-output) {
    min-height: 340px;
  }

  .hero-caption {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0.875rem 0 0;
    color: var(--snaplot-ink-secondary);
    font-size: 0.875rem;
    max-width: none;
  }

  /* On a phone the button sits above its three lines rather than beside the first. */
  @media (max-width: 40rem) {
    .hero-caption {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* Wide enough for "Back to live", so the caption does not move when the label changes. */
  .hero-toggle {
    flex: none;
    min-width: 6.5rem;
    padding: 0.25rem 0.75rem;
    font: inherit;
    color: var(--snaplot-ink);
    background-color: var(--snaplot-background);
    border: 1px solid var(--snaplot-rule);
    border-radius: var(--snaplot-radius);
    cursor: pointer;
  }

  .hero-toggle:hover {
    background-color: var(--snaplot-surface);
    border-color: var(--snaplot-ink-secondary);
  }

  .hero-toggle:focus-visible {
    outline: 2px solid var(--snaplot-accent);
    outline-offset: 2px;
  }

  /* The examples: a grid of pictures with their questions under them, each item one link. */
  .examples-title {
    margin-block: 5rem 0.5rem;
    font-size: 1.75rem;
    letter-spacing: -0.015em;
  }
  .examples-intro {
    margin: 0 0 2rem;
    color: var(--snaplot-ink-secondary);
    font-size: 1.0625rem;
  }
  ul.home-examples {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    ul.home-examples {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.5rem;
    }
  }
  @media (min-width: 64rem) {
    ul.home-examples {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  ul.home-examples > li {
    position: relative;
  }
  ul.home-examples picture {
    display: block;
  }
  .demo-thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--snaplot-rule);
    border-radius: var(--snaplot-radius);
    transition: border-color 120ms ease;
  }
  /* The light pages' pictures sit a little dimmer on a dark page. */
  :global(:root[data-theme='dark']) .demo-thumb {
    filter: brightness(0.88);
  }
  .home-examples h3 {
    margin: 0.875rem 0 0.25rem;
    font-size: 1.0625rem;
    line-height: 1.35;
  }
  .home-examples h3 a {
    color: var(--snaplot-ink);
    text-decoration: none;
  }
  /* The whole item is the link: its picture, its question and its line. */
  .home-examples h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .home-examples li:hover .demo-thumb {
    border-color: var(--snaplot-ink-secondary);
  }
  .home-examples li:hover h3 a,
  .home-examples h3 a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .home-examples .demo-meta {
    font-size: 0.8125rem;
  }
</style>
