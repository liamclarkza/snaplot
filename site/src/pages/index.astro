---
/**
 * The homepage (plan §9, D34), in order: one sentence, two ways in and the install string, the
 * facts as chips, then the stage: a chart that streams while you read, its live readouts, and in
 * three tabs the very file that draws it. Then the six chart types as live pictures, the examples,
 * and a last way in. There are no performance adjectives or benchmark numbers: the only facts are
 * the version, the measured gzip size of each entry point and the peer ranges (gap-competitive-04).
 */
import { execFileSync } from 'node:child_process';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import ChartTypeCards from '../components/ChartTypeCards.astro';
import Example from '../components/Example.astro';
import { Code } from '@astrojs/starlight/components';
import Site from '../layouts/Site.astro';
import { DEMOS } from '../lib/demos';
import routes from '../lib/old-routes.json';
import {
  dependencyCount,
  installCommand,
  isPrerelease,
  releaseLine,
  version,
} from '../lib/version';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = join(process.cwd(), '..');
/** The social card, written by `npm run thumbs` (uisite-20). */
const card = new URL(`${base}examples/social-card.jpg`, Astro.site).href;

// The gzip size of each entry point, as an app that imports it pays (scripts/size.mjs, G6).
// size.mjs prints the sizes, then exits 1 when an import is over its budget (its stderr says
// which): the page still shows what was measured, and `npm run check:size` is the gate that fails.
type Size = { from: string; gzipBytes: number };
function measure(): Size[] {
  let printed: string | undefined;
  try {
    printed = execFileSync(process.execPath, [join(repo, 'scripts/size.mjs'), '--json'], {
      encoding: 'utf8',
    });
  } catch (error) {
    printed = (error as { stdout?: string }).stdout;
  }
  try {
    return JSON.parse(printed ?? '') as Size[];
  } catch (error) {
    throw new Error('homepage: `node scripts/size.mjs --json` printed no sizes', { cause: error });
  }
}
const sizes = measure();
const kb = (bytes: number) => `${(bytes / 1024).toFixed(1)} KB`;
const entrySizes = ['snaplot', 'snaplot/react', 'snaplot/solid'].map((entry) => {
  const measured = sizes.filter((row) => row.from === entry);
  return { entry, size: kb(Math.max(...measured.map((row) => row.gzipBytes))) };
});

// "React 19" from `^19.0.0`, "React 18.3/19" from `^18.3.0 || ^19.0.0`.
const peers =
  (
    JSON.parse(readFileSync(join(repo, 'packages/snaplot/package.json'), 'utf8')) as {
      peerDependencies?: Record<string, string>;
    }
  ).peerDependencies ?? {};
const supported = (range = '') =>
  range
    .split('||')
    .map((part) => /(\d+)\.(\d+)/.exec(part))
    .filter((m) => m !== null)
    .map(([, major, minor]) => (minor === '0' ? major : `${major}.${minor}`))
    .join('/');

/** The chips: what a fact is about, then its value. */
const facts: { label: string; value: string }[] = [
  { label: 'version', value: `v${version}` },
  ...entrySizes.map(({ entry, size }) => ({ label: 'gzip', value: `${entry} ${size}` })),
  { label: 'runtime', value: `${dependencyCount} dependencies` },
  { label: 'peers', value: `React ${supported(peers.react)}` },
  { label: 'peers', value: `Solid ${supported(peers['solid-js'])}` },
];

/** The hero's simulator is the deploy-482 example's; the caption links to it once it is built. */
const incident = existsSync(join(process.cwd(), 'src/pages/examples/deploy-482.astro'));

const examples = DEMOS.map((demo) => ({
  ...demo,
  page: existsSync(join(process.cwd(), `src/pages/examples/${demo.slug}.astro`)),
  thumbnail: existsSync(join(process.cwd(), `public/examples/${demo.slug}.jpg`)),
}));
---

<Site
  title="snaplot: canvas charts for live data"
  description="Canvas charts for live data. One options object for vanilla JS, React and Solid."
  current="home"
>
  <Fragment slot="head">
    <meta property="og:image" content={card} />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>
  <script slot="head" is:inline define:vars={{ routes, base }}>
    // Old hash links, /snaplot/#/docs/<group>/<section>, land on their new pages (plan §8.2).
    const route = /^#\/([^?#]*)/.exec(location.hash);
    if (route) {
      const [page, group, section] = route[1].split('/');
      const target =
        page === 'docs' && group
          ? (routes.docs[`${group}/${section}`] ?? routes.docs[group] ?? routes.pages.docs)
          : routes.pages[page];
      if (target) location.replace(base + target);
      else if (target === '') history.replaceState(null, '', base);
    }
  </script>

  <div class="intro">
    <!-- The release line, and the way in for 0.12 users: this release breaks their code. -->
    <a class="kicker" href={`${base}migrate-0-12/`}>
      <span class="kicker-tag">{isPrerelease ? `${releaseLine} beta` : releaseLine}</span>
      <span>Moving from 0.12?</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
    <!-- One sentence pair (research-10): the claim at display size, the framework promise under
         it. The full stop of the claim is the live point. -->
    <h1 class="lede">
      <span class="lede-main"
        >Canvas charts for <span class="lede-live"
          >live<svg
            class="lede-spark"
            viewBox="0 0 120 14"
            preserveAspectRatio="none"
            aria-hidden="true"
            focusable="false"><path d="M2 10 9 8l7 3 8-6 7 4 8-5 7 7 8-3 7 2 9-8 8 5 9-2 8 4 9-6 7 2"
            ></path></svg
          ></span
        > data<span class="live-stop">.</span></span
      >
      {' '}<span class="lede-sub">One options object for vanilla JS, React and Solid.</span>
    </h1>
    <div class="actions">
      <a class="button button-primary" href={`${base}first-chart/`}
        >Draw your first chart <span class="arrow" aria-hidden="true">→</span></a
      >
      <a class="button" href={`${base}examples/`}>See the examples</a>
      <!-- The install string (D1), as a plain code line with its copy button. -->
      <div class="install"><Code code={installCommand()} lang="sh" frame="none" /></div>
    </div>
    <ul class="facts num" aria-label="Facts">
      {
        facts.map((fact) => (
          <li class="chip">
            <span class="fact-label">{fact.label}</span> <strong>{fact.value}</strong>
          </li>
        ))
      }
    </ul>
  </div>

  <section class="stage" aria-labelledby="hero-title" data-stage>
    <h2 id="hero-title" class="sr-only">A chart and its code</h2>
    <div class="stage-bar">
      <p class="stage-status">
        <strong data-readout="status">Live</strong>
        <span class="stage-what">/search latency</span>
      </p>
      <dl class="readouts num">
        <div class="readout">
          <dt><span class="swatch swatch-1"></span>p50</dt>
          <dd><span data-readout="p50">–</span><span class="unit"> ms</span></dd>
        </div>
        <div class="readout">
          <dt><span class="swatch swatch-2"></span>p99</dt>
          <dd><span data-readout="p99">–</span><span class="unit"> ms</span></dd>
        </div>
        <div class="readout">
          <dt>rows since you arrived</dt>
          <dd data-readout="streamed">0</dd>
        </div>
      </dl>
      <button type="button" class="hero-toggle" data-hero-toggle>Pause</button>
    </div>
    <Example name="home/hero" />
  </section>
  <p class="hero-caption">
    A simulated service: the latency of its /search endpoint, thirty seconds of data a second. Deploy
    #482 lands at 03:08 UTC.{' '}
    {
      incident ? (
        <a href={`${base}examples/deploy-482/`}>Did it cause the spike?</a>
      ) : (
        'Did it cause the spike?'
      )
    }
    <span class="hint">Drag across the chart to zoom; double-click to go back.</span>
  </p>

  <section class="home-section" aria-labelledby="types-title">
    <div class="section-head">
      <h2 id="types-title">Six chart types</h2>
      <p>
        A series' <code>type</code> decides how it draws. Each picture is a live chart; its page has
        the recipes, in all three frameworks.
      </p>
      <a class="section-link" href={`${base}chart-types/`}
        >All chart types <span class="arrow" aria-hidden="true">→</span></a
      >
    </div>
    <ChartTypeCards />
  </section>

  <section class="home-section" aria-labelledby="examples-title">
    <div class="section-head">
      <h2 id="examples-title">Six questions, answered</h2>
      <p>Each example answers one question with real or documented data.</p>
      <a class="section-link" href={`${base}examples/`}
        >All examples <span class="arrow" aria-hidden="true">→</span></a
      >
    </div>
    <ul class="home-examples">
      {
        examples.map((demo) => (
          <li class="demo-card" data-demo={demo.slug}>
            {demo.thumbnail && (
              <picture class="demo-card-picture">
                {/* A phone shows a close-up of the page's main chart: the whole page cannot be
                    read at its width. */}
                <source
                  media="(max-width: 39.99rem)"
                  srcset={`${base}examples/${demo.slug}-close.jpg 640w, ${base}examples/${demo.slug}-close@2x.jpg 1280w`}
                  sizes="100vw"
                />
                <img
                  class="demo-thumb"
                  src={`${base}examples/${demo.slug}.jpg`}
                  srcset={`${base}examples/${demo.slug}.jpg 640w, ${base}examples/${demo.slug}@2x.jpg 1280w`}
                  sizes="(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw"
                  alt=""
                  width="640"
                  height="400"
                  loading="lazy"
                />
              </picture>
            )}
            <div class="demo-card-body">
              <h3>
                {demo.page ? (
                  <a href={`${base}examples/${demo.slug}/`}>{demo.question}</a>
                ) : (
                  demo.question
                )}
              </h3>
              <p class="demo-meta">
                <span class="framework" data-framework={demo.framework}>
                  {demo.framework}
                </span>{' '}
                · {demo.dataset}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <svg class="closing-line" viewBox="0 0 400 240" aria-hidden="true" focusable="false">
      <path
        d="M0 205 28 196 52 210 80 184 104 192 132 160 156 172 184 139 210 150 236 112 262 126 290 88 316 98 344 58 372 66"
      ></path>
      <circle cx="372" cy="66" r="9"></circle>
    </svg>
    <h2 id="closing-title">Plot something that moves</h2>
    <p>
      Give a chart an element and one options object, then append rows as they arrive. The same
      object works in plain JavaScript, in React and in Solid.
    </p>
    <div class="actions">
      <a class="button button-ink" href={`${base}first-chart/`}
        >Draw your first chart <span class="arrow" aria-hidden="true">→</span></a
      >
      <a class="button button-on-ember" href={`${base}reference/api/`}>Read the API</a>
    </div>
  </section>
</Site>

<script>
  import { bindHeroReadouts, bindHeroToggle } from '../examples/data/latency-feed';

  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  if (toggle) bindHeroToggle(toggle);
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  if (stage) bindHeroReadouts(stage);
</script>

<style>
  /* The opening: the claim at display size, then two ways in, the install line and the facts. */
  .intro {
    padding-block: clamp(1rem, 4vw, 3.5rem) 0;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.25rem;
    margin-bottom: 1.75rem;
    padding: 0.25rem 0.875rem 0.25rem 0.3125rem;
    border: 1px solid var(--snaplot-rule);
    border-radius: var(--snaplot-radius-pill);
    background-color: var(--snaplot-raised);
    color: var(--snaplot-ink-secondary);
    font-size: 0.875rem;
    text-decoration: none;
    box-shadow: var(--snaplot-shadow-sm);
    transition: border-color 160ms ease;
  }
  .kicker:hover {
    border-color: var(--snaplot-rule-strong);
    color: var(--snaplot-ink);
  }
  .kicker-tag {
    padding: 0.125rem 0.625rem;
    border-radius: var(--snaplot-radius-pill);
    background-color: var(--snaplot-ember);
    color: var(--snaplot-on-ember);
    font-family: var(--snaplot-font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .kicker .arrow {
    transition: transform 160ms var(--snaplot-ease);
  }
  .kicker:hover .arrow {
    transform: translateX(3px);
  }

  .lede {
    max-width: none;
    margin-block: 0 2.25rem;
  }
  .lede-main {
    --lede-size: clamp(3.25rem, 1.25rem + 8.5vw, 8.5rem);
    display: block;
    max-width: 11ch;
    font-size: var(--lede-size);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  /* "live" carries a small line drawn in ember, which draws itself in once. */
  .lede-live {
    position: relative;
    display: inline-block;
  }
  .lede-spark {
    position: absolute;
    left: 0.02em;
    right: 0.04em;
    bottom: -0.06em;
    width: calc(100% - 0.06em);
    height: 0.14em;
    overflow: visible;
  }
  .lede-spark path {
    fill: none;
    stroke: var(--snaplot-point);
    stroke-width: clamp(3px, 0.045em, 6px);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    animation: draw 1.6s 0.3s var(--snaplot-ease) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  /* The full stop is the newest point: the character stays for readers (at no size), and an ember
     dot sits on the baseline in its place. */
  .live-stop {
    font-size: 0;
    color: transparent;
  }
  .live-stop::before {
    content: '';
    display: inline-block;
    width: calc(var(--lede-size) * 0.17);
    height: calc(var(--lede-size) * 0.17);
    margin-inline-start: calc(var(--lede-size) * 0.035);
    border-radius: 50%;
    background-color: var(--snaplot-point);
  }
  @media (prefers-reduced-motion: reduce) {
    .lede-spark path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
  .lede-sub {
    display: block;
    max-width: 34ch;
    margin-top: 1.5rem;
    color: var(--snaplot-ink-secondary);
    font-family: var(--snaplot-font);
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  /* The install line as wide as its command, a pill like the buttons beside it. */
  .install {
    inline-size: fit-content;
    min-inline-size: 15rem;
  }
  .install :global(.expressive-code pre) {
    border-radius: var(--snaplot-radius-pill);
    border-color: var(--snaplot-rule);
  }
  .install :global(.expressive-code .ec-line) {
    padding-inline-start: 1.25rem;
  }
  .install :global(.expressive-code .copy) {
    inset-inline-end: 0.375rem;
  }
  .install :global(.expressive-code .copy button) {
    border-radius: var(--snaplot-radius-pill);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .fact-label {
    color: var(--snaplot-ink-secondary);
  }
  /* A phone: the facts run in one row that scrolls sideways, faded at its end. */
  @media (max-width: 39.99rem) {
    .facts {
      flex-wrap: nowrap;
      margin-inline: calc(-1 * var(--snaplot-gutter));
      padding-inline: var(--snaplot-gutter);
      overflow-x: auto;
      scrollbar-width: none;
      mask-image: linear-gradient(90deg, #000 85%, transparent);
    }
    .facts::-webkit-scrollbar {
      display: none;
    }
  }

  /* The stage: the chart that streams while you read, its readouts, and the file that draws it. */
  .stage {
    position: relative;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    border: 1px solid var(--snaplot-rule);
    border-radius: var(--snaplot-radius-lg);
    background-color: var(--snaplot-raised);
    box-shadow: var(--snaplot-shadow-lg);
    overflow: hidden;
  }
  .stage-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--snaplot-rule);
  }
  .stage-status {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    font-size: 0.875rem;
  }
  .stage-status strong {
    min-width: 3.75rem;
    font-weight: 600;
  }
  .stage-what {
    color: var(--snaplot-ink-secondary);
    font-family: var(--snaplot-font-mono);
    font-size: 0.8125rem;
  }
  .readouts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.75rem;
    margin: 0;
  }
  .readout {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .readout dt {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--snaplot-ink-secondary);
    font-size: 0.8125rem;
  }
  .readout dd {
    margin: 0;
    min-width: 3ch;
    font-family: var(--snaplot-font-mono);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .readout .unit {
    color: var(--snaplot-ink-secondary);
    font-size: 0.75rem;
  }
  .swatch {
    width: 0.625rem;
    height: 0.1875rem;
    border-radius: var(--snaplot-radius-pill);
    background-color: var(--snaplot-series-1);
  }
  .swatch-2 {
    background-color: var(--snaplot-series-2);
  }

  /* Wide enough for "Back to live", so the bar does not move when the label changes. */
  .hero-toggle {
    flex: none;
    min-width: 7.5rem;
    min-height: 2.25rem;
    padding: 0.25rem 1rem;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 550;
    color: var(--snaplot-ink);
    background-color: var(--snaplot-surface);
    border: 1px solid var(--snaplot-rule);
    border-radius: var(--snaplot-radius-pill);
    cursor: pointer;
    transition:
      background-color 120ms ease,
      border-color 120ms ease;
  }
  .hero-toggle:hover {
    border-color: var(--snaplot-ink-secondary);
  }
  .hero-toggle[data-live='false'] {
    border-color: var(--snaplot-ember);
    background-color: var(--snaplot-ember);
    color: var(--snaplot-on-ember);
  }
  .hero-toggle:focus-visible {
    outline: 2px solid var(--snaplot-accent);
    outline-offset: 2px;
  }

  /* The example's own card folds into the stage. */
  .stage :global(.example) {
    margin: 0;
    border: 0;
    border-radius: 0;
    background-color: transparent;
    box-shadow: none;
  }
  .stage :global(.example-tabs) {
    margin: 0.75rem 1.25rem 0;
  }
  .stage :global(.example-output) {
    padding: 1rem 1rem 0.75rem;
  }
  .stage :global([data-example-code]) {
    border-top: 1px solid var(--snaplot-rule);
  }
  .stage :global([data-example-code] .expressive-code .frame) {
    border-radius: 0;
  }
  .stage :global([data-example-code] .expressive-code .frame pre) {
    max-height: 20rem;
    overflow: auto;
    border-width: 0;
    border-radius: 0;
  }
  .stage :global([data-example-code] .expressive-code .frame .header) {
    border-radius: 0;
  }

  /* A phone: the state and the toggle on one row, the readouts under them. */
  @media (max-width: 39.99rem) {
    .stage-bar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.625rem 1rem;
      padding: 0.75rem 1rem;
    }
    .stage-status strong {
      min-width: 0;
    }
    .stage-what {
      white-space: nowrap;
    }
    .readouts {
      grid-column: 1 / -1;
      grid-row: 2;
      gap: 0.25rem 1.25rem;
    }
    .stage :global(.example-tabs) {
      margin: 0.75rem 1rem 0;
    }
  }

  /* Wide screens: the tabs sit in the bar, the chart is the larger half and its code runs the
     chart's height beside it. */
  @media (min-width: 64rem) {
    .stage-bar {
      padding-inline-end: 18rem;
    }
    .stage :global(.example-tabs) {
      position: absolute;
      top: 0.75rem;
      right: 1.25rem;
      margin: 0;
    }
    .stage :global(.example-panel:not([hidden])) {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: stretch;
    }
    .stage :global(.example-output) {
      padding: 1.5rem 1.5rem 1rem;
    }
    .stage :global([data-example-code]) {
      border-top: 0;
      border-left: 1px solid var(--snaplot-rule);
    }
    .stage :global([data-example-code] .expressive-code .frame pre) {
      max-height: 23.25rem;
    }
  }

  /* The hero's code asks for 340px. The adapters do not size their host from `height` yet
     (frameworks-15, D26), so the islands' wrappers and the vanilla mount (sized for the docs'
     280px examples) take it here, or the chart runs over the code below it on a phone. */
  .stage :global(.example-island),
  .stage :global(.example-chart) {
    height: 340px;
  }
  .stage :global(.example-output) {
    min-height: 340px;
  }

  .hero-caption {
    max-width: 72ch;
    margin: 1.125rem 0 0;
    color: var(--snaplot-ink-secondary);
    font-size: 0.875rem;
  }
  .hint {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--snaplot-font-mono);
    font-size: 0.75rem;
  }

  /* Sections: a heading with its sentence and a link, then the grid. */
  .home-section {
    margin-top: clamp(5rem, 10vw, 8rem);
  }
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem 2rem;
    align-items: end;
    margin-bottom: 2rem;
  }
  .section-head h2 {
    margin: 0;
  }
  .section-head p {
    margin: 0;
    color: var(--snaplot-ink-secondary);
    font-size: 1.0625rem;
  }
