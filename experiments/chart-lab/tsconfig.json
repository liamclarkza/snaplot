{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "snaplot": ["../../packages/snaplot/src/index.ts"], "snaplot/react": ["../../packages/snaplot/src/react.ts"] }
  },
  "include": ["src", "vite.config.ts"]
}
