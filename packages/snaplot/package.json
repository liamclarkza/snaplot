{
  "name": "snaplot",
  "version": "1.0.0-beta.0",
  "type": "module",
  "description": "Canvas charts for live data. One options object for vanilla JS, React and Solid.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "solid": "./dist/solid.jsx",
      "worker": "./dist/solid.server.js",
      "browser": "./dist/solid.js",
      "deno": "./dist/solid.server.js",
      "node": "./dist/solid.server.js",
      "default": "./dist/solid.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --config vite.ssr.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test -c test/browser/playwright.config.ts",
    "ledger": "node ../../scripts/ledger.mjs",
    "prepack": "node -e \"for (const f of ['README.md', 'LICENSE']) require('fs').copyFileSync('../../' + f, f)\"",
    "postpack": "node -e \"for (const f of ['README.md', 'LICENSE']) require('fs').rmSync(f, { force: true })\"",
    "check:package": "publint --strict && attw --pack . --profile esm-only && node scripts/check-consumers.mjs",
    "check:api": "node scripts/check-api.mjs",
    "api:update": "node scripts/check-api.mjs --update",
    "test:tz": "TZ=America/Los_Angeles vitest run time Time .tz. && TZ=Asia/Kathmandu vitest run time Time .tz. && TZ=UTC vitest run time Time .tz.",
    "conformance:install": "node test/conformance/install.mjs",
    "test:conformance": "node test/conformance/run.mjs",
    "test:visual": "node test/visual/run.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.61.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.4",
    "jsdom": "30.1.0",
    "publint": "0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "solid-js": "^1.9.5",
    "typedoc": "0.28.20",
    "typescript": "^5.7.0",
    "vite": "7.3.7",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liamclarkza/snaplot.git"
  },
  "license": "MIT",
  "homepage": "https://liamclarkza.github.io/snaplot/",
  "bugs": {
    "url": "https://github.com/liamclarkza/snaplot/issues"
  },
  "keywords": [
    "chart",
    "charts",
    "canvas",
    "time series",
    "streaming",
    "react",
    "solid",
    "plot"
  ]
}
