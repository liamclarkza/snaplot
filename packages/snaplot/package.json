{
  "name": "snaplot",
  "version": "0.12.0",
  "type": "module",
  "description": "High-performance charts that actually look good",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "browser": "./dist/solid.js",
      "node": "./dist/solid.server.js",
      "default": "./dist/solid.js"
    },
    "./legend-table.css": {
      "import": "./dist/legend-table.css",
      "default": "./dist/legend-table.css"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "dist/*.css"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.ssr.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:consumers": "node scripts/check-consumers.mjs"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.61.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.4",
    "jsdom": "30.1.0",
    "publint": "0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "solid-js": "^1.9.5",
    "typedoc": "0.28.20",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liamclarkza/snaplot.git"
  },
  "license": "MIT",
  "homepage": "https://liamclarkza.github.io/snaplot/",
  "bugs": {
    "url": "https://github.com/liamclarkza/snaplot/issues"
  },
  "keywords": [
    "solidjs",
    "chart",
    "canvas",
    "visualization",
    "dashboard",
    "heatmap",
    "scatter",
    "histogram",
    "line-chart",
    "bar-chart",
    "time-series",
    "plotting"
  ]
}
