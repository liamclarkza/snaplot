{
  // Type-checks the tests outside src/ (test/**) together with the library source.
  // The build config (tsconfig.json) keeps rootDir ./src for declaration output.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // The conformance pages import the entries by name, as an application does.
    "paths": {
      "snaplot": ["./src/index.ts"],
      "snaplot/react": ["./src/react.ts"],
      "snaplot/solid": ["./src/solid.ts"]
    }
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist", "dev"]
}
