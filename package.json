{
  "name": "snaplot-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "bench"
  ],
  "scripts": {
    "build": "npm run build -w packages/snaplot",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "verify": "biome ci . && npm run typecheck && npm test && npm run build",
    "test:watch": "npm run test:watch -w packages/snaplot",
    "test:visual": "npm run test:visual -w packages/snaplot --",
    "test:browser": "npm run test:browser -w packages/snaplot --",
    "test:conformance": "npm run test:conformance -w packages/snaplot --",
    "conformance:install": "npm run conformance:install -w packages/snaplot --",
    "test:tz": "npm run test:tz -w packages/snaplot --",
    "ledger": "npm run ledger -w packages/snaplot --",
    "trace-check": "npm run trace-check -w packages/snaplot --",
    "check:package": "npm run check:package -w packages/snaplot --",
    "check:size": "node scripts/size.mjs",
    "check:api": "npm run check:api -w packages/snaplot --",
    "api:update": "npm run api:update -w packages/snaplot --",
    "check:palettes": "node scripts/check-palettes.mjs",
    "check:examples": "npm run check:examples -w site --",
    "build:site": "npm run build -w site --",
    "dev": "npm run dev -w site --",
    "dev:lib": "npm run dev -w packages/snaplot",
    "demo-data": "node scripts/demo-data/index.mjs",
    "thumbs": "node scripts/thumbs.mjs",
    "bench": "npm run bench -w bench --",
    "bench:ab": "npm run bench:ab -w bench --",
    "bench:compare": "npm run bench:compare -w bench --",
    "metrics": "node scripts/overhaul/metrics.mjs",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "format": "biome format --write .",
    "prepare": "lefthook install || true"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "esbuild": "0.27.7",
    "lefthook": "^2.1.6"
  }
}
